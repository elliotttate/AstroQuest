+            const u32 value = static_cast<u32>(rate);
+            std::memcpy(at(FrameRateValue), &value, 4);
+            std::memcpy(at(FrameRateValue) + 4, &value, 4);
+            *at(FrameRateHeldCmp) = static_cast<u8>(rate);
